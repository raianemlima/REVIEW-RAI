{
  "name": "revisao-dpe",
  "version": "1.0.0",
  "private": true,
  "description": "Revisão Espaçada DPE: app de iPhone (Capacitor) a partir do site.",
  "scripts": {
    "www": "node scripts/build-www.mjs",
    "sync": "npm run www && npx cap sync ios",
    "assets": "npx capacitor-assets generate --ios --iconBackgroundColor '#155e4a' --splashBackgroundColor '#155e4a'"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0"
  }
}
